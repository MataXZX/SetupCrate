<Window x:Class="SetupCrate.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SetupCrate.Services"
        Title="SetupCrate" Width="560" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource Fg}" FontSize="13">


    <Border Background="{DynamicResource BgWindow}">
        <DockPanel Margin="20">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <CheckBox x:Name="ChkRemember" Style="{StaticResource ConsentCheck}"
                          Foreground="{DynamicResource Fg}" FontSize="12" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnConfirm" Style="{StaticResource PrimaryBtn}" Width="150"
                            Margin="0,0,8,0" Click="BtnConfirm_Click"/>
                    <Button Content="{loc:Tr Text='Отмена'}" Style="{StaticResource GhostBtn}" Width="110"
                            IsCancel="True"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtBody" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource Fg}" Margin="0,0,0,14"/>
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <CheckBox x:Name="ChkAccept" Style="{StaticResource ConsentCheck}"
                              Checked="ChkAccept_Changed" Unchecked="ChkAccept_Changed">
                        <TextBlock x:Name="TxtAccept" TextWrapping="Wrap" MaxWidth="450" Foreground="{DynamicResource Fg}"/>
                    </CheckBox>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
