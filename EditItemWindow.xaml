<Window x:Class="SetupCrate.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись каталога" Height="640" Width="730"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource Fg}" FontSize="13">
    <Border Background="{DynamicResource BgWindow}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="OK" Style="{StaticResource PrimaryBtn}" Width="120" Margin="0,0,8,0"
                    IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryBtn}" Width="120" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Название программы *" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Style="{StaticResource InputBox}"/>
                <TextBlock Text="Официальный сайт (для справки и поиска ссылок)" Margin="0,12,0,4"/>
                <TextBox x:Name="TxtSite" Style="{StaticResource InputBox}"/>
                <TextBlock Text="Прямая ссылка на установщик *" Margin="0,12,0,4"/>
                <TextBox x:Name="TxtUrl" Style="{StaticResource InputBox}"/>
                <Button x:Name="BtnFind" Content="Найти ссылки на странице…" Style="{StaticResource SecondaryBtn}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="BtnFind_Click"/>
                <TextBlock Text="Категория" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtCategory" Style="{StaticResource InputBox}"/>
                    <Button x:Name="BtnCategories" Grid.Column="2" Content="▾"
                            Style="{StaticResource SecondaryBtn}" Padding="0" Click="BtnCategories_Click"/>
                </Grid>
                <TextBlock Text="Заметки (например: ставить в C:\Program1\..., версия x64)" Margin="0,12,0,4"/>
                <TextBox x:Name="TxtNotes" Style="{StaticResource InputBoxArea}" Height="62"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Дополнительно (можно оставить пустым)" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Флаги тихой установки" Grid.Row="0"/>
                    <TextBlock Text="Папка установки (подсказка)" Grid.Row="0" Grid.Column="2"/>
                    <TextBox x:Name="TxtSilent" Grid.Row="1" Style="{StaticResource InputBox}" Margin="0,4,0,0"/>
                    <TextBox x:Name="TxtTarget" Grid.Row="1" Grid.Column="2" Style="{StaticResource InputBox}"
                             Margin="0,4,0,0"/>

                    <TextBlock Text="Ожидаемый SHA-256 (необязательно)" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,4"/>
                    <TextBox x:Name="TxtHash" Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource InputBox}"/>

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0" Foreground="{DynamicResource FgMuted}"
                               TextWrapping="Wrap" FontSize="12"
                               Text="Флаги нужны только если хочешь ставить молча — путь тогда будет стандартный. Пусто = обычный запуск установщика, где путь выбираешь сам."/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </Border>
</Window>
