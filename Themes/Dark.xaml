    <SolidColorBrush x:Key="ErrFg" Color="#FCA5A5"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7FA5FF" Offset="0"/>
        <GradientStop Color="#9B8BFF" Offset="1"/>
    </LinearGradientBrush></ResourceDictionary>
