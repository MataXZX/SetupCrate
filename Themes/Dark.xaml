<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgWindow" Color="#0A0E14"/>
    <SolidColorBrush x:Key="WindowBackdrop" Color="#0A0E14"/>
    <SolidColorBrush x:Key="BgSurface" Color="#10151C"/>
    <SolidColorBrush x:Key="BgCard" Color="#151B24"/>
    <SolidColorBrush x:Key="CardBg" Color="#151B24"/>
    <SolidColorBrush x:Key="BgHover" Color="#1C2431"/>
    <SolidColorBrush x:Key="BgSelected" Color="#22324F"/>
    <SolidColorBrush x:Key="Border" Color="#26303D"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#3A4A61"/>
    <SolidColorBrush x:Key="Fg" Color="#EDF3FB"/>
    <SolidColorBrush x:Key="FgMuted" Color="#93A2B8"/>
    <SolidColorBrush x:Key="Accent" Color="#5D8CFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#7FA5FF"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#4A78E8"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0A1220"/>
