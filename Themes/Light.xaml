    <SolidColorBrush x:Key="OverlayBg" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="BgSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgHover" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="BgSelected" Color="#DCE7FF"/>
    <SolidColorBrush x:Key="Border" Color="#D5DDE8"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#B6C2D2"/>
    <SolidColorBrush x:Key="Fg" Color="#0B1220"/>
    <SolidColorBrush x:Key="FgMuted" Color="#5B6B80"/>
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
