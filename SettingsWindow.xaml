<Window x:Class="SetupCrate.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SetupCrate.Services"
        Title="{loc:Tr Text='Настройки'}" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource Fg}" FontSize="13">
    <Border Background="{DynamicResource BgWindow}">
        <DockPanel Margin="18">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{loc:Tr Text='Закрыть'}" Style="{StaticResource SecondaryBtn}" Width="120"
                        IsCancel="True" Click="BtnClose_Click"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Text='Язык'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnAuto" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"
                                Content="{loc:Tr Text='Как в системе'}" Click="BtnAuto_Click"/>
                        <Button x:Name="BtnRu" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"
                                Content="{loc:Tr Text='Русский'}" Click="BtnRu_Click"/>
                        <Button x:Name="BtnEn" Style="{StaticResource GhostBtn}"
                                Content="English" Click="BtnEn_Click"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,16"/>

                    <TextBlock Text="{loc:Tr Text='Каталог'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                                Content="{loc:Tr Text='Импорт каталога…'}" Click="BtnImport_Click"/>
                        <Button Style="{StaticResource SecondaryBtn}"
                                Content="{loc:Tr Text='Экспорт каталога…'}" Click="BtnExport_Click"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,16"/>

                    <TextBlock Text="{loc:Tr Text='Обновления'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtVersion" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,8"/>
                    <Button x:Name="BtnCheckUpdates" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left"
                            Content="{loc:Tr Text='Проверить обновления'}" Click="BtnCheckUpdates_Click"/>
                    <TextBlock x:Name="TxtUpdateStatus" Foreground="{DynamicResource FgMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,16"/>

                    <TextBlock Text="{loc:Tr Text='О программе'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left"
                            Content="{loc:Tr Text='О SetupCrate'}" Click="BtnAbout_Click"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
