<Window x:Class="SetupCrate.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SetupCrate.Services"
        Title="{loc:Tr Text='О SetupCrate'}" Height="520" Width="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource Fg}" FontSize="13"
>
    <Border Background="{DynamicResource BgWindow}">
        <DockPanel Margin="20">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="{loc:Tr Text='Поблагодарить'}" Style="{StaticResource GhostBtn}" Width="140"
                        Margin="0,0,8,0" Click="BtnThanks_Click"/>
                <Button Content="{loc:Tr Text='Лицензия'}" Style="{StaticResource GhostBtn}" Width="120"
                        Margin="0,0,8,0" Click="BtnLicense_Click"/>
                <Button Content="{loc:Tr Text='Закрыть'}" Style="{StaticResource PrimaryBtn}" Width="120"
                        IsCancel="True" Click="BtnClose_Click"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="SetupCrate" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
                <TextBlock x:Name="TxtVersion" HorizontalAlignment="Center"
                           Foreground="{DynamicResource FgMuted}" Margin="0,6,0,0"/>
                <TextBlock Text="{loc:Tr Text='Каталог установщиков для Windows'}" HorizontalAlignment="Center"
                           Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Hyperlink Click="BtnSite_Click">
                        <Run Text="github.com/MataXZX/SetupCrate"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="{loc:Tr Text='Copyright © 2026 SetupCrate'}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource FgMuted}" Margin="0,16,0,0"/>
                <TextBlock Text="{loc:Tr Text='Собрано на .NET 10 и WPF'}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource FgMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
