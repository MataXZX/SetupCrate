<Window x:Class="SetupCrate.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SetupCrate.Services"
        Title="SetupCrate" Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource Fg}" FontSize="13">
    <Window.Resources>
        <Style x:Key="ReportRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Ellipse x:Name="ring" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.5"/>
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource Accent}" Opacity="0"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="dot" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgWindow}">
        <DockPanel Margin="20">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="{loc:Tr Text='Отмена'}" Style="{StaticResource GhostBtn}" Width="110"
                        IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="BtnSend" Content="{loc:Tr Text='Отправить жалобу'}"
                        Style="{StaticResource DangerBtn}" Width="170" IsEnabled="False"
                        Click="BtnSend_Click"/>
            </StackPanel>

            <StackPanel>
                <TextBlock x:Name="TxtReportTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtReportMeta" FontSize="12" Foreground="{DynamicResource FgMuted}"
                           Margin="0,0,0,14"/>

                <TextBlock Text="{loc:Tr Text='В чём проблема?'}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <RadioButton x:Name="R1" Style="{StaticResource ReportRadio}" GroupName="reason"
                             Checked="Reason_Checked"
                             Content="{loc:Tr Text='Подозрение на вирус / вредоносную ссылку'}"/>
                <RadioButton x:Name="R2" Style="{StaticResource ReportRadio}" GroupName="reason"
                             Checked="Reason_Checked"
                             Content="{loc:Tr Text='Пиратское ПО (кряк, репак, активатор)'}"/>
                <RadioButton x:Name="R3" Style="{StaticResource ReportRadio}" GroupName="reason"
                             Checked="Reason_Checked"
                             Content="{loc:Tr Text='Ссылка ведёт не на официальный сайт'}"/>
                <RadioButton x:Name="R4" Style="{StaticResource ReportRadio}" GroupName="reason"
                             Checked="Reason_Checked"
                             Content="{loc:Tr Text='Ссылки не работают (ошибка скачивания)'}"/>
                <RadioButton x:Name="R5" Style="{StaticResource ReportRadio}" GroupName="reason"
                             Checked="Reason_Checked"
                             Content="{loc:Tr Text='Неприемлемое название или спам'}"/>

                <TextBlock Text="{loc:Tr Text='Комментарий (необязательно):'}" FontWeight="SemiBold"
                           Margin="0,10,0,6"/>
                <TextBox x:Name="TxtComment" Style="{StaticResource InputBoxArea}" Height="70"
                         TextWrapping="Wrap" AcceptsReturn="True"/>

                <CheckBox x:Name="ChkHide" Style="{StaticResource ConsentCheck}" Margin="0,14,0,0"
                          Foreground="{DynamicResource Fg}"
                          Content="{loc:Tr Text='Скрыть эту сборку из моего списка'}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
