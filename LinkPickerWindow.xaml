<Window x:Class="SetupCrate.LinkPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Найденные файлы" Height="500" Width="780"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource Fg}" FontSize="13">
    <Border Background="{DynamicResource BgWindow}">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{DynamicResource FgMuted}"
                   Text="Выбери ссылку на установщик. Если нужного файла нет — закрой окно и скопируй ссылку с сайта вручную."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="Выбрать" Style="{StaticResource PrimaryBtn}" Width="120" Margin="0,0,8,0"
                    IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryBtn}" Width="120" IsCancel="True"/>
        </StackPanel>
        <Border Style="{StaticResource Card}" ClipToBounds="True">
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Margin="8"
                     FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource Fg}" MouseDoubleClick="List_MouseDoubleClick"/>
        </Border>
    </DockPanel>
    </Border>
</Window>
