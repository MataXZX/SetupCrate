<Window x:Class="SetupCrate.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SetupCrate.Services"
        Title="{loc:Tr Text='Категория'}" Height="200" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource Fg}" FontSize="13">
    <Border Background="{DynamicResource BgWindow}">
        <DockPanel Margin="18">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="OK" Style="{StaticResource PrimaryBtn}" Width="110" Margin="0,0,8,0"
                        IsDefault="True" Click="BtnOk_Click"/>
                <Button Content="{loc:Tr Text='Отмена'}" Style="{StaticResource GhostBtn}" Width="110" IsCancel="True"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TxtPrompt" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBox x:Name="TxtValue" Style="{StaticResource InputBox}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
